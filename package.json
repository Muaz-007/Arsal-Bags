    "lucide-react": "^0.453.0",
    "next": "14.2.15",
    "nodemailer": "^7.0.7",
    "pg": "^8.13.1",
    "next-auth": "^4.24.8",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "stripe": "^17.2.0",
