# MySQL via Prisma — leave empty to use in-memory mock data
# Example:  DATABASE_URL="mysql://root:password@localhost:3306/bagsart"
DATABASE_URL=

# NextAuth
NEXTAUTH_SECRET=replace-me-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (test keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudinary (optional, for admin product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed credentials for the default admin
ADMIN_EMAIL=admin@bagsart.dev
ADMIN_PASSWORD=admin12345
