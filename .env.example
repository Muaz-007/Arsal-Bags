# PostgreSQL via Prisma — leave empty to use in-memory mock data
# Neon example: postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Public site URL — used by sitemap, robots, canonical tags, OG meta, JSON-LD.
# Set this to the production domain on Vercel (e.g. https://bagsart.com).
# Falls back to VERCEL_URL, then NEXTAUTH_URL, then localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth
NEXTAUTH_SECRET=replace-me-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — "Continue with Google" on the sign-in / sign-up screen
# Get these from Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI must be: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (test keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SMTP — transactional email (welcome, password reset, order confirmation)
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=<16-char App Password, NOT your Google password>
#   SMTP_SECURE=false   # 465 = true, 587 = false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="BagsArt <bags.art.pk@gmail.com>"

# Cloudinary (optional, for admin product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed credentials for the default admin (used by `npm run db:seed`)
ADMIN_EMAIL=bags.art.pk@gmail.com
ADMIN_PASSWORD=admin12345

# WhatsApp — international format, no `+`, no spaces (Pakistan: 92 + phone
# without leading 0). Leave blank to hide the floating chat button.
# Example: 923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=
