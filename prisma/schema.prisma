// BagsArt Prisma schema — PostgreSQL (Neon / Supabase / Vercel Postgres)
// Run `npx prisma generate` after install, and `npx prisma db push` (or
// `npx prisma migrate dev`) when DATABASE_URL is configured.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  admin
}

enum OrderStatus {
  pending
  paid
  fulfilled
  shipped
  delivered
  cancelled
}

enum CouponType {
  percent
  fixed
}

enum PaymentMethod {
  card
  cod
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(customer)

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  verificationCode EmailVerificationCode?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// NextAuth adapter tables ------------------------------------------------------
model Account {
  id                 String   @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Catalogue -------------------------------------------------------------------
model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  tagline     String
  description String    @db.Text
  price       Decimal   @db.Decimal(10, 2)
  compareAt   Decimal?  @db.Decimal(10, 2)
  currency    String    @default("USD")
  category    String
  collection  String?
  colors      Json
  materials   Json
  images      Json
  // Free-form key/value spec table shown on the PDP — dimensions, weight,
  // laptop fit, closure type, whatever varies per SKU. Stored as
  // `[{ label: "Dimensions", value: "28 × 32 × 12 cm" }, ...]` so admins
  // can add whichever rows make sense for each product.
  specifications Json?
  stock       Int       @default(0)
  featured    Boolean   @default(false)
  rating      Float     @default(0)
  reviewCount Int       @default(0)

  reviews     Review[]
  orderItems  OrderItem[]
  wishlistedBy WishlistItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([collection])
  @@index([featured])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// Admin-controlled storefront config — what shows in the hero, the strip,
// and which products are pinned to Featured / Best sellers / Summer sale.
// Stored as JSON per section key so the schema doesn't need a migration
// every time a section adds a field.
model StorefrontConfig {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  author    String
  rating    Int
  title     String
  body      String   @db.Text
  // Customer-uploaded photos (Cloudinary URLs). Stored as JSON so we can
  // grow the shape (thumbnails, dimensions) without a migration.
  images    Json     @default("[]")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id             String      @id @default(cuid())
  userId         String?
  customerName   String
  customerEmail  String
  // Contact phone captured at checkout so the courier / studio can reach
  // the customer without opening the account record. Optional so orders
  // from the pre-phone era don't need a backfill.
  customerPhone  String?
  subtotal       Decimal     @db.Decimal(10, 2)
  shipping       Decimal     @db.Decimal(10, 2) @default(0)
  tax            Decimal     @db.Decimal(10, 2) @default(0)
  total          Decimal     @db.Decimal(10, 2)
  status         OrderStatus   @default(pending)
  paymentMethod  PaymentMethod @default(cod)
  paymentRef     String?
  // Courier tracking — admin pastes whatever the courier gave them. We
  // store the URL too so customers can click-through to TCS/Leopards/etc.
  trackingNumber String?
  trackingUrl    String?
  // Free-text reason captured from the customer when they cancel. Null
  // for orders that are still in flight or were never cancelled. Stored
  // as raw text (capped in the API) rather than an enum so the admin can
  // read the "Other" details verbatim.
  cancellationReason String?

  user           User?       @relation(fields: [userId], references: [id])
  items          OrderItem[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  name      String
  image     String
  color     String?
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Coupon {
  code      String     @id
  type      CouponType
  value     Decimal    @db.Decimal(10, 2)
  active    Boolean    @default(true)
  expiresAt DateTime?
  // Optional redemption cap. When set, the coupon is refused at checkout
  // once `uses >= maxUses`. Null means unlimited redemptions.
  maxUses   Int?
  uses      Int        @default(0)

  createdAt DateTime   @default(now())
}

// One-time tokens used to confirm an email-address change. We send the
// verification link to the NEW email so we know the user controls it
// before swapping over.
model EmailChangeToken {
  token     String   @id
  userId    String
  newEmail  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// One active 6-digit signup verification code per user (one-to-one via
// userId as the primary key — sending a fresh code overwrites the old
// one via upsert). The plaintext code itself is never stored; only a
// bcrypt hash sits in `codeHash`. `attempts` bounds brute-force guessing
// on a single code before we invalidate it and force a resend.
model EmailVerificationCode {
  userId    String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  source    String?
  createdAt DateTime @default(now())
}

// Contact form submissions from /contact. Stored in the DB alongside the
// email we send to bags.art.pk@gmail.com so the admin panel has a single
// authoritative inbox — the Gmail thread can still be lost or missed, but
// the admin dashboard always shows every unread enquiry.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([readAt])
}

model PasswordResetToken {
  token     String   @id
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model SavedAddress {
  id           String   @id @default(cuid())
  userId       String
  label        String?
  name         String
  address      String
  city         String
  country      String
  postal       String
  phone        String?
  isDefault    Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}
